{
  "name": "termdeck-cli",
  "version": "2.0.6",
  "description": "Terminal project control: a multi-pane TUI to manage your local dev projects — dev servers, git state, process stats, and AI coding agents.",
  "keywords": [
    "cli",
    "tui",
    "dashboard",
    "blessed",
    "blessed-contrib",
    "dev-server",
    "projects",
    "agents"
  ],
  "license": "MIT",
  "main": "src/index.js",
  "bin": {
    "termdeck": "src/index.js"
  },
  "files": [
    "src",
    "sample-config.json",
    "README.md"
  ],
  "engines": {
    "node": ">=16"
  },
  "scripts": {
    "start": "node src/index.js",
    "test": "node test/run.js",
    "smoke": "node test/smoke.js"
  },
  "dependencies": {
    "blessed": "^0.1.81",
    "blessed-contrib": "^4.11.0",
    "cross-spawn": "^7.0.3",
    "inquirer": "^8.2.6",
    "open": "^8.4.2",
    "pidusage": "^3.0.2"
  }
}
